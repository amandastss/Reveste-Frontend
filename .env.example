# URL do backend, com ou sem o sufixo /api (o cliente HTTP normaliza e acrescenta /api).
VITE_API_URL=http://localhost:8000

# Chave PÚBLICA do Mercado Pago correspondente ao ambiente configurado no backend.
# Obtenha-a no painel do Mercado Pago; nunca use aqui MERCADO_PAGO_ACCESS_TOKEN ou webhook secret.
VITE_MERCADO_PAGO_PUBLIC_KEY=
